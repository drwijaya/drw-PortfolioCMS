# Contact form: Resend SMTP; verify davidrwijaya.site before adding the API key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
CONTACT_FROM=hello@davidrwijaya.site
CONTACT_TO=davidrwijaya@gmail.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Public collector origin. The collector stores only allow-listed, anonymous data.
NEXT_PUBLIC_ANALYTICS_API_URL=https://api.your-domain.com

# Analytics API service. ANALYTICS_SECRET is optional; when blank, the service
# creates one inside its persistent data volume instead of the repository.
ANALYTICS_SECRET=
ANALYTICS_ALLOWED_ORIGINS=https://your-domain.com
ANALYTICS_RETENTION_DAYS=730
ANALYTICS_PRIVACY_THRESHOLD=5
